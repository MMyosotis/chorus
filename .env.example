# Chorus 环境变量示例：复制为 .env 后填入真实密钥值。
# 各模型条目的完整配置（base_url / model_id 等）在 chorus/config.py 的模型表中，.env 只放密钥值。

# --- 对话模型（必需）：CHAT_MODELS 各条 api_key_env 指向的变量，用到哪条配哪条 ---
DEEPSEEK_API_KEY=

# --- 生图模型（使用配图功能时必需）：IMAGE_MODELS 各条 options.api_key_env 指向的变量 ---
ARK_API_KEY=

# --- 联网搜索（可选）：百度千帆智能搜索，配合设置面板的联网搜索开关使用 ---
BAIDU_SEARCH_API_KEY=

# --- 日志（可选，均有默认值）---
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=5000000
# LOG_BACKUP_COUNT=5
# LOG_RETENTION_DAYS=7
# LOG_CLEANUP_INTERVAL=21600
